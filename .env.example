NODE_ENV=development
PORT=8000
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-this-local-password
MONGO_URI=mongodb://root:change-this-local-password@localhost:27017/aics_booking?authSource=admin
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=local-only-change-this-to-a-random-32-character-secret
SESSION_COOKIE_NAME=aics.sid
COOKIE_SECURE=false
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-this-mongo-express-password
